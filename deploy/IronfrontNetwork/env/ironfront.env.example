# Copy this file to:
# /etc/warlabs/ironfront/ironfront.env
#
# Replace every placeholder with real values.
# Never commit or upload the real server environment file.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL: AuthService
IRONFRONT_AUTH_DB_CONNECTION="Host=127.0.0.1;Port=5432;Database=warlabs_ironfront_database_authservice;Username=warlabs_ironfront_user_authservice;Password=CHANGE_ME"

# PostgreSQL: UserService
IRONFRONT_USER_DB_CONNECTION="Host=127.0.0.1;Port=5432;Database=database_ironfront_userservice;Username=user_ironfront_userservice;Password=CHANGE_ME"

# PostgreSQL: MatchmakingService
IRONFRONT_MATCHMAKING_DB_CONNECTION="Host=127.0.0.1;Port=5432;Database=database_ironfront_matchmakingservice;Username=user_ironfront_matchmakingservice;Password=CHANGE_ME"

# Shared authentication settings
IRONFRONT_JWT_SIGNING_KEY="CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_SECRET"
IRONFRONT_JWT_ISSUER="Ironfront.AuthService"
IRONFRONT_JWT_AUDIENCE="Ironfront.Client"

# Internal service authentication
IRONFRONT_INTERNAL_SERVICE_KEY="CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_SECRET"

# Dedicated BattleServer control authentication
IRONFRONT_BATTLE_SERVER_CONTROL_KEY="CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_SECRET"

# AuthService
IRONFRONT_AUTHSERVICE_PORT=5010
IRONFRONT_AUTHSERVICE_URL="http://127.0.0.1:5010"

# UserService
IRONFRONT_USERSERVICE_PORT=5020
IRONFRONT_USERSERVICE_URL="http://127.0.0.1:5020"

# MatchmakingService
IRONFRONT_MATCHMAKING_PORT=5030
IRONFRONT_MATCHMAKING_ENABLE_DEVELOPMENT_ENDPOINTS=false
IRONFRONT_BATTLE_SERVER_RECONCILIATION_INTERVAL_SECONDS=5
IRONFRONT_BATTLE_JOIN_TICKET_LIFETIME_SECONDS=90
IRONFRONT_MATCHMAKING_INTERVAL_MILLISECONDS=1000
IRONFRONT_MATCHMAKING_MAXIMUM_MATCHES_PER_MODE_PER_CYCLE=8
IRONFRONT_MATCHMAKING_URL="http://127.0.0.1:5030"

# Default user provisioning
IRONFRONT_DEFAULT_STARTER_VEHICLE_ID="germany.ground.panzer_ii_f"
IRONFRONT_DEFAULT_STARTER_DECK_NAME="Starter Deck"

# Shared catalog path for Gateway and UserService.
IRONFRONT_GAME_DATA_DIRECTORY="/opt/warlabs/ironfront/game-data"

# Gateway stays behind Caddy.
IRONFRONT_GATEWAY_HOSTING_MODE="ReverseProxy"

# Optional Namecheap DDNS updater settings.
IRONFRONT_DDNS_DOMAIN="warlabs.net"
IRONFRONT_DDNS_HOST="gateway"
IRONFRONT_DDNS_PASSWORD="CHANGE_ME_NAMECHEAP_DDNS_PASSWORD"
