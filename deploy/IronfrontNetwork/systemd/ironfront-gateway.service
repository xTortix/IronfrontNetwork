[Unit]
Description=Ironfront Gateway
After=network-online.target ironfront-auth.service ironfront-user.service ironfront-matchmaking.service
Wants=network-online.target ironfront-auth.service ironfront-user.service ironfront-matchmaking.service

[Service]
WorkingDirectory=/opt/warlabs/ironfront/gateway
ExecStart=/usr/bin/dotnet /opt/warlabs/ironfront/gateway/Ironfront.Gateway.dll
EnvironmentFile=/etc/warlabs/ironfront/ironfront.env
User=ironfront
Group=ironfront
Restart=always
RestartSec=5
SyslogIdentifier=ironfront-gateway
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
